# Copia este archivo a .env y completa los valores reales.
# .env esta ignorado por git: NUNCA lo subas al repositorio.

# API key de Pinecone (Consola -> API Keys)
PINECONE_API_KEY=

# Host del indice (Consola -> Indexes -> tu indice -> Host)
PINECONE_INDEX_HOST=

# Namespace donde estan los chunks indexados por ingesta/
PINECONE_NAMESPACE=documents-dev

# Campo que el indice usa para embedding (field_map del indice)
PINECONE_TEXT_FIELD=text

# Cantidad de chunks relevantes a recuperar por consulta
PINECONE_TOP_K=5

# API key de OpenRouter (https://openrouter.ai/keys, sin tarjeta)
OPENROUTER_API_KEY=

# Modelo LLM (los modelos free terminan en :free)
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Base URL de OpenRouter (compatible con la API de OpenAI)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Turnos de historial que se envian al LLM junto con la pregunta
HISTORY_TURNS=6
